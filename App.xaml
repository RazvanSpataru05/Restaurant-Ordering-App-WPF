<Application x:Class="RestaurantOrderingApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RestaurantOrderingApp.ViewModels"
             xmlns:views="clr-namespace:RestaurantOrderingApp.Views"
             xmlns:local="clr-namespace:RestaurantOrderingApp">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:AdminPanelVM}">
                <views:AdminPanelView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LowStockVM}">
                <views:LowStockView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>