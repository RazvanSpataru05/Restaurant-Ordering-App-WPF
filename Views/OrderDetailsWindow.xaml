<Window x:Class="RestaurantOrderingApp.Views.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        WindowStyle="None"
        Background="#1C1C1C"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C9A84C"/>
            <Setter Property="BorderBrush" Value="#C9A84C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C9A84C"/>
                                <Setter Property="Foreground" Value="#1C1C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border BorderBrush="#C9A84C" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="ORDER DETAILS"
                           FontFamily="Georgia" FontStyle="Italic"
                           FontSize="20" Foreground="#C9A84C"
                           HorizontalAlignment="Center"/>
                <Rectangle Height="1" Fill="#2A2A2A" Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock FontFamily="Georgia" FontSize="12" Foreground="#888888">
                    <Run Text="Order Code: "/>
                    <Run Text="{Binding OrderDisplayed.Order.OrderCode}" 
                         Foreground="#C9A84C" FontFamily="Consolas"/>
                </TextBlock>
                <TextBlock FontFamily="Georgia" FontSize="12" Foreground="#888888" Margin="0,4">
                    <Run Text="Date: "/>
                    <Run Text="{Binding OrderDisplayed.Order.OrderDate, StringFormat={}{0:dd MMM yyyy HH:mm}}" 
                         Foreground="#E0E0E0"/>
                </TextBlock>
                <TextBlock FontFamily="Georgia" FontSize="12" Foreground="#888888" Margin="0,4">
                    <Run Text="Status: "/>
                    <Run Text="{Binding OrderDisplayed.Order.Status}" Foreground="#C9A84C"/>
                </TextBlock>
                <TextBlock FontFamily="Georgia" FontSize="12" Foreground="#888888" Margin="0,4">
                    <Run Text="ETA: "/>
                    <Run Text="{Binding OrderDisplayed.Order.EstimatedDeliveryTime, StringFormat={}{0:HH:mm}}" 
                         Foreground="#E0E0E0"/>
                </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="2">
                <ItemsControl ItemsSource="{Binding OrderDisplayed.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="Georgia" FontSize="13"
                                               Foreground="#E0E0E0" VerticalAlignment="Center">
                                        <Run Text="{Binding ProductName}"/>
                                        <Run Text="{Binding MenuName}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Margin="15,0"
                                               FontFamily="Georgia" FontSize="13"
                                               Foreground="#888888" VerticalAlignment="Center">
                                        <Run Text="x"/>
                                        <Run Text="{Binding Quantity}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" FontFamily="Georgia" FontSize="13"
                                               Foreground="#C9A84C" VerticalAlignment="Center">
                                        <Run Text="{Binding UnitPrice}"/>
                                        <Run Text=" RON"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,15,0,0">
                <TextBlock FontFamily="Georgia" FontSize="14" Foreground="#C9A84C"
                           VerticalAlignment="Center">
                    <Run Text="Total: "/>
                    <Run Text="{Binding OrderDisplayed.Order.TotalPrice, StringFormat={}{0:F2}}"/>
                    <Run Text=" RON"/>
                </TextBlock>
                <Button Content="Close" HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource HeaderButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>