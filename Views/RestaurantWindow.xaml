<Window x:Class="RestaurantOrderingApp.Views.RestaurantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RestaurantOrderingApp.ViewModels"
        xmlns:local="clr-namespace:RestaurantOrderingApp.Views"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        Title="Sapori d'Italia"
        Background="#1C1C1C">
    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="ApplicationCommands.Close"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close"
                        Executed="CloseCommand_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C9A84C"/>
            <Setter Property="BorderBrush" Value="#C9A84C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C9A84C"/>
                                <Setter Property="Foreground" Value="#1C1C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#141414" 
                BorderBrush="#2A2A2A" BorderThickness="0 0 0 1">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="☰  Menu"
                        Style="{StaticResource HeaderButtonStyle}"
                        Command="{Binding OpenMenuCommand}"
                        VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <TextBlock Text="Sapori d'Italia"
                               Foreground="#C9A84C"
                               FontFamily="Georgia"
                               FontSize="20"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="· Cucina Autentica Italiana ·"
                               Foreground="#666666"
                               FontFamily="Georgia"
                               FontSize="10"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="ProfileButton"
                        Command="{Binding ToggleProfileMenuCommand}"
                        Style="{StaticResource HeaderButtonStyle}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤  " FontSize="14"/>
                        <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Popup IsOpen="{Binding IsProfileMenuOpen}"
                       PlacementTarget="{Binding ElementName=ProfileButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       HorizontalOffset="-16.5">
                    <Border Background="#141414" BorderBrush="#C9A84C" BorderThickness="1">
                        <StackPanel>
                            <Button Content="View Cart" Command="{Binding OpenCartCommand}"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    BorderThickness="0"/>
                            <Button Content="View My Orders" Command="{Binding OpenOrderHistoryCommand}"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <local:WelcomeView>
                <local:WelcomeView.Style>
                    <Style TargetType="local:WelcomeView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:WelcomeView.Style>
            </local:WelcomeView>

            <ContentControl Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:MenuVM}">
                        <local:MenuView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:CartVM}">
                        <local:CartView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>