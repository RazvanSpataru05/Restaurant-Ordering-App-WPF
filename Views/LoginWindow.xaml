<Window x:Class="RestaurantOrderingApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Title="Login" Height="400" Width="500">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <StackPanel Margin="20">

        <StackPanel Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,5"/>
            <PasswordBox x:Name="PasswordBox" 
                         PasswordChanged="PasswordBox_PasswordChanged"
                         Margin="0,5"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,5"/>
        </StackPanel>

        <StackPanel Visibility="{Binding IsRegisterVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <ContentPresenter Content="{Binding RegisterVM}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button Content="Continue as Guest" Command="{Binding GuestCommand}" Margin="5"/>
            <Button Content="Sign Up" Command="{Binding NavigateToRegisterCommand}" Margin="5"/>
            <Button Content="Log In" Command="{Binding LoginCommand}" Margin="5"/>
        </StackPanel>

    </StackPanel>
</Window>   