<Window x:Class="RestaurantOrderingApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowState="Maximized"
        Title="Login"
        Background="Transparent">

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command ="{Binding CloseCommand}"/>
        <KeyBinding Key="Return" Command="{Binding LoginCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="LoginFieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="CaretBrush" Value="#C9A84C"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#C9A84C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,6"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#C9A84C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <TextBlock Text="✕"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E74C3C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Rectangle Fill="#1C1C1C"/>

        <Rectangle Opacity="0.18">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5"
                                     RadiusX="0.7" RadiusY="0.7"
                                     GradientOrigin="0.5,0.4">
                    <GradientStop Color="#C9A84C" Offset="0"/>
                    <GradientStop Color="#1C1C1C" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle Opacity="0.55">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5"
                                     RadiusX="0.85" RadiusY="0.85">
                    <GradientStop Color="Transparent" Offset="0.4"/>
                    <GradientStop Color="#000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid VerticalAlignment="Top" Height="56">
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0"
                    Style="{StaticResource WindowCloseButton}"
                    Command="{Binding CloseCommand}"
                    ToolTip="Chiudi"/>
        </Grid>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Rectangle Width="48" Height="1" Fill="#C9A84C" Opacity="0.6"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="❦" Foreground="#C9A84C" FontSize="14"
                           VerticalAlignment="Center"/>
                <Rectangle Width="48" Height="1" Fill="#C9A84C" Opacity="0.6"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Sapori d'Italia"
                       FontFamily="Georgia" FontStyle="Italic"
                       FontSize="36" Foreground="#C9A84C"
                       HorizontalAlignment="Center" Margin="0,0,0,4">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#C9A84C"
                                      BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.35"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="· Cucina Autentica Italiana ·"
                       FontFamily="Georgia" FontStyle="Italic"
                       FontSize="11" Foreground="#888888"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Benvenuto"
                       FontFamily="Georgia" FontStyle="Italic"
                       FontSize="13" Foreground="#C9A84C"
                       Opacity="0.75"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,28"/>

            <Border Background="#141414" BorderBrush="#2A2A2A"
                    BorderThickness="1" CornerRadius="4" Padding="32,30">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                      BlurRadius="40"
                                      ShadowDepth="0"
                                      Opacity="0.7"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="EMAIL" Style="{StaticResource LoginFieldLabel}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginTextBox}" Margin="0,0,0,16"/>

                        <TextBlock Text="PASSWORD" Style="{StaticResource LoginFieldLabel}"/>
                        <PasswordBox x:Name="LoginPasswordBox"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Style="{StaticResource LoginPasswordBox}"
                                     Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#E74C3C" FontFamily="Georgia"
                                   FontSize="11" Margin="0,0,0,20"
                                   TextWrapping="Wrap"/>

                        <Button Content="Log In"
                                Command="{Binding LoginCommand}"
                                Style="{StaticResource CartButtonStyle}"
                                Height="38" Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,16">
                            <Rectangle Height="1" Fill="#2A2A2A" VerticalAlignment="Center"/>
                            <Border Background="#141414" Padding="12,0" HorizontalAlignment="Center">
                                <TextBlock Text="or" FontFamily="Georgia"
                                           FontStyle="Italic" FontSize="10"
                                           Foreground="#555555"/>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Continue as Guest"
                                    Command="{Binding GuestCommand}"
                                    Style="{StaticResource ToggleButtonStyle}"
                                    FontSize="11" Margin="0,0,8,0"/>
                            <Button Content="Sign Up"
                                    Command="{Binding NavigateToRegisterCommand}"
                                    Style="{StaticResource ToggleButtonStyle}"
                                    FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DataContext="{Binding RegisterVM}"
                                Visibility="{Binding DataContext.IsRegisterVisible,
                                             RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource BoolToVisibilityConverter}}">

                        <TextBlock Text="FIRST NAME" Style="{StaticResource LoginFieldLabel}"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="LAST NAME" Style="{StaticResource LoginFieldLabel}"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="EMAIL" Style="{StaticResource LoginFieldLabel}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="PASSWORD" Style="{StaticResource LoginFieldLabel}"/>
                        <PasswordBox x:Name="RegisterPasswordBox"
                                     PasswordChanged="RegisterPasswordBox_PasswordChanged"
                                     Style="{StaticResource LoginPasswordBox}"
                                     Margin="0,0,0,12"/>

                        <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource LoginFieldLabel}"/>
                        <PasswordBox x:Name="RegisterConfirmPasswordBox"
                                     PasswordChanged="RegisterConfirmPasswordBox_PasswordChanged"
                                     Style="{StaticResource LoginPasswordBox}"
                                     Margin="0,0,0,12"/>

                        <TextBlock Text="PHONE" Style="{StaticResource LoginFieldLabel}"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="ADDRESS" Style="{StaticResource LoginFieldLabel}"/>
                        <TextBox Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginTextBox}" Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#E74C3C" FontFamily="Georgia"
                                   FontSize="11" Margin="0,0,0,20"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="← Back"
                                    Command="{Binding BackToLoginCommand}"
                                    Style="{StaticResource ToggleButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Sign Up"
                                    Command="{Binding RegisterCommand}"
                                    Style="{StaticResource CartButtonStyle}"
                                    Height="36" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Rectangle Width="36" Height="2" Fill="#4F8F4F" Opacity="0.55"/>
                <Rectangle Width="36" Height="2" Fill="#F5F5F0" Opacity="0.55"/>
                <Rectangle Width="36" Height="2" Fill="#C62828" Opacity="0.55"/>
            </StackPanel>

            <TextBlock Text="Mangia bene, vivi felice"
                       FontFamily="Georgia" FontStyle="Italic"
                       FontSize="10" Foreground="#666666"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>