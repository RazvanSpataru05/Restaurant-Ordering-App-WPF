<Window x:Class="RestaurantOrderingApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Title="Login" Height="500" Width="400">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <StackPanel Margin="20">


        <StackPanel Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Email"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0 5"/>
            <TextBlock Text="Password"/>
            <PasswordBox x:Name="LoginPasswordBox" PasswordChanged="PasswordBox_PasswordChanged" Margin="0 5"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0 5"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20">
                <Button Content="Continue as Guest" Command="{Binding GuestCommand}" Margin="5"/>
                <Button Content="Sign Up" Command="{Binding NavigateToRegisterCommand}" Margin="5"/>
                <Button Content="Log In" Command="{Binding LoginCommand}" Margin="5"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DataContext="{Binding RegisterVM}"
                    Visibility="{Binding DataContext.IsRegisterVisible, 
                    RelativeSource={RelativeSource AncestorType=Window},
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="First Name"/>
            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0 5"/>
            
            <TextBlock Text="Last Name"/>
            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0 5"/>
            
            <TextBlock Text="Email"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0 5"/>
            
            <TextBlock Text="Password"/>
            <PasswordBox x:Name="RegisterPasswordBox" PasswordChanged="RegisterPasswordBox_PasswordChanged" Margin="0 5"/>
            
            <TextBlock Text="Confirm Password"/>
            <PasswordBox x:Name="RegisterConfirmPasswordBox" PasswordChanged="RegisterConfirmPasswordBox_PasswordChanged" Margin="0 5"/>
            
            <TextBlock Text="Phone Number"/>
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0 5"/>
            
            <TextBlock Text="Address"/>
            <TextBox Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0 5"/>
            
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0 5"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20">
                <Button Content="Back to Login" Command="{Binding BackToLoginCommand}" Margin="5"/>
                <Button Content="Sign Up" Command="{Binding RegisterCommand}" Margin="5"/>
            </StackPanel>
        </StackPanel>

    </StackPanel>
</Window>