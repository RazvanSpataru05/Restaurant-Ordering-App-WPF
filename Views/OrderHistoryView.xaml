<UserControl x:Class="RestaurantOrderingApp.Views.OrderHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RestaurantOrderingApp.Converters"
             Background="#1C1C1C">
    <UserControl.Resources>
        <converters:StringTrimConverter x:Key="StringTrim"/>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="MY ORDERS"
                       FontFamily="Georgia" FontStyle="Italic"
                       FontSize="22" Foreground="#C9A84C"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="· Your Order History ·"
                       FontFamily="Georgia" FontSize="11"
                       Foreground="#555555" HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
            <Rectangle Height="1" Fill="#2A2A2A" Margin="0,12,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewerStyle}">
            <ListBox ItemsSource="{Binding OrdersDisplayed}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     SelectedItem="{Binding SelectedOrder}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
                                            Padding="0,18" Margin="0,0,0,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1A3A5C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontFamily="Consolas" FontSize="16"
                                           Foreground="#C9A84C" FontWeight="Bold"
                                           Margin="0,0,0,6">
                                    <Run Text="ORD-"/>
                                    <Run Text="{Binding Order.OrderCode}"/>
                                </TextBlock>
                                <TextBlock FontFamily="Georgia" FontSize="12"
                                           Foreground="#888888" Margin="0,2">
                                    <Run Text="Placed: "/>
                                    <Run Text="{Binding Order.OrderDate, StringFormat={}{0:dd MMM yyyy · HH:mm}}"
                                         Foreground="#E0E0E0"/>
                                </TextBlock>
                                <TextBlock FontFamily="Georgia" FontSize="12"
                                           Foreground="#888888" Margin="0,2">
                                    <Run Text="ETA: "/>
                                    <Run Text="{Binding Order.EstimatedDeliveryTime, StringFormat={}{0:HH:mm}}"
                                         Foreground="#E0E0E0"/>
                                </TextBlock>
                                <TextBlock FontFamily="Georgia" FontSize="12"
                                           Foreground="#888888" Margin="0,2">
                                    <Run Text="Total: "/>
                                    <Run Text="{Binding Order.TotalPrice, StringFormat={}{0:F2}}"
                                         Foreground="#C9A84C"/>
                                    <Run Text=" RON" Foreground="#C9A84C"/>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="2" CornerRadius="10" Padding="10,4"
                                    VerticalAlignment="Center" Margin="20,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Order.Status, Converter={StaticResource StringTrim}}" Value="Recorded">
                                                <Setter Property="Background" Value="#1A3A5C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Order.Status, Converter={StaticResource StringTrim}}" Value="Delivered">
                                                <Setter Property="Background" Value="#1A4A2E"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Order.Status, Converter={StaticResource StringTrim}}" Value="Canceled">
                                                <Setter Property="Background" Value="#4A1A1A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontFamily="Georgia" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#E0E0E0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Order.Status}" Value="Recorded">
                                                    <Setter Property="Foreground" Value="#4A9EDB"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Order.Status}" Value="Delivered">
                                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Order.Status}" Value="Canceled">
                                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding Order.Status}"/>
                                </TextBlock>
                            </Border>

                            <Button Grid.Column="3" Content="i"
                                    Style="{StaticResource InfoButtonStyle}"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.ShowOrderDetailsCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Button Content="← Close"
                    Style="{StaticResource CartButtonStyle}"
                    HorizontalAlignment="Left"
                    Command="{Binding CloseCommand}"/>
            <Button Content="Cancel Order"
                    Style="{StaticResource CartButtonStyle}"
                    Command="{Binding CancelOrderCommand}"
                    HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>