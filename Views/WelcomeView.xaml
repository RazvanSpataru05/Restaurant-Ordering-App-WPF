<UserControl x:Class="RestaurantOrderingApp.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1C1C1C">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="SAPORI D'ITALIA"
                   Foreground="#C9A84C"
                   FontFamily="Georgia"
                   FontSize="48"
                   FontStyle="Italic"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="· · ·"
                   Foreground="#C9A84C"
                   FontSize="20"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>
        <TextBlock Text="&quot;A tavola non si invecchia&quot;"
                   Foreground="#888888"
                   FontFamily="Georgia"
                   FontStyle="Italic"
                   FontSize="16"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="At the table, one never grows old."
                   Foreground="#555555"
                   FontFamily="Georgia"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,5"/>
        <TextBlock Text="Press Menu to explore our selection"
                   Foreground="#444444"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,30"/>
    </StackPanel>
</UserControl>