<UserControl x:Class="RestaurantOrderingApp.Views.LowStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RestaurantOrderingApp.Converters"
             Background="#1C1C1C"
             TextElement.Foreground="#E0E0E0">
    <UserControl.Resources>
        <converters:PortionQuantityToUnitConverter x:Key="PortionToUnit"/>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="LOW STOCK ALERT"
                       FontFamily="Georgia" FontStyle="Italic"
                       FontSize="22" Foreground="#C9A84C"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="· Products approaching depletion ·"
                       FontFamily="Georgia" FontSize="11"
                       Foreground="#555555" HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
            <Rectangle Height="1" Fill="#2A2A2A" Margin="0,12,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding LowStockProducts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#181818" BorderBrush="#2A2A2A"
                                BorderThickness="1" CornerRadius="4"
                                Margin="0,0,0,10">
                            <Grid>
                                <Border Width="4" HorizontalAlignment="Left"
                                        Background="#E74C3C" CornerRadius="4,0,0,4"/>
                                <Grid Margin="20,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="Georgia" FontSize="13"
                                                   FontWeight="Bold" Foreground="#E0E0E0"/>
                                        <TextBlock FontFamily="Georgia" FontSize="11"
                                                   Foreground="#888888" Margin="0,3,0,0">
                                            <Run Text="Portion: "/>
                                            <Run Text="{Binding PortionQuantity}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" 
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <TextBlock Text="↓ " Foreground="#E74C3C" 
                                                   FontSize="13" FontWeight="Bold"
                                                   FontFamily="Georgia"/>
                                        <TextBlock FontFamily="Georgia" FontSize="13"
                                                   FontWeight="Bold" Foreground="#E74C3C">
                                            <Run Text="{Binding TotalQuantity, StringFormat={}{0:F0}}"/>
                                            <Run Text="{Binding PortionQuantity, Converter={StaticResource PortionToUnit}}"/>
                                        </TextBlock>    
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
    </Grid>
</UserControl>