<UserControl x:Class="RestaurantOrderingApp.Views.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1C1C1C"
             TextElement.Foreground="#E0E0E0">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="YOUR CART"
                       FontFamily="Georgia"
                       FontSize="22"
                       FontStyle="Italic"
                       Foreground="#C9A84C"/>
            <Rectangle Height="1" Fill="#2A2A2A" Margin="0 10 0 0"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding CartMessage}"
                   Visibility="{Binding IsCartEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                   FontFamily="Georgia"
                   FontStyle="Italic"
                   FontSize="15"
                   Foreground="#555555"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CartItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#2A2A2A" BorderThickness="0 0 0 1" Padding="0 15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="70" Height="70"
                                        Background="#252525"
                                        CornerRadius="4">
                                    <TextBlock Text="🍽"
                                               FontSize="28"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" Margin="15 0" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Georgia"
                                               FontSize="14"
                                               Foreground="#E0E0E0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}">
                                                <Binding Path="Product.Name"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontFamily="Georgia"
                                               FontSize="12"
                                               Foreground="#888888"
                                               Margin="0 4 0 0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1} RON">
                                                <Binding Path="Product.PortionQuantity"/>
                                                <Binding Path="Product.Price"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontFamily="Georgia"
                                               FontSize="13"
                                               Foreground="#C9A84C"
                                               Margin="0 6 0 0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="Total: {0} RON">
                                                <Binding Path="TotalPrice"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                                            VerticalAlignment="Center" Margin="10 0">
                                    <Button Content="−"
                                            Style="{StaticResource CartButtonStyle}"
                                            Width="32.5" Height="32.5"
                                            Command="{Binding DataContext.DecreaseCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding Quantity}"
                                               FontFamily="Georgia"
                                               FontSize="14"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center"
                                               Margin="10 0"
                                               MinWidth="20"
                                               TextAlignment="Center"/>
                                    <Button Content="+"
                                            Style="{StaticResource CartButtonStyle}"
                                            Width="32.5" Height="32.5"
                                            Command="{Binding DataContext.IncreaseCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Content="🗑"
                                        FontSize="16"
                                        Style="{StaticResource CartButtonStyle}"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveFromCartCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0 20 0 10" HorizontalAlignment="Right" MinWidth="300">
            <Rectangle Height="1" Fill="#2A2A2A" Margin="0 0 0 15"/>
            <Grid Margin="0 4">
                <TextBlock Text="Subtotal" FontFamily="Georgia" Foreground="#888888"/>
                <TextBlock HorizontalAlignment="Right" FontFamily="Georgia" Foreground="#E0E0E0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} RON">
                            <Binding Path="Subtotal"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
            <Grid Margin="0 4">
                <TextBlock Text="Delivery" FontFamily="Georgia" Foreground="#888888"/>
                <TextBlock HorizontalAlignment="Right" FontFamily="Georgia" Foreground="#E0E0E0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} RON">
                            <Binding Path="DeliveryCost"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
            <Grid Margin="0 4">
                <TextBlock Text="Discount" FontFamily="Georgia" Foreground="#888888"/>
                <TextBlock HorizontalAlignment="Right" FontFamily="Georgia" Foreground="#C9A84C">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="− {0} RON">
                            <Binding Path="DiscountAmount"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
            <Rectangle Height="1" Fill="#2A2A2A" Margin="0 10"/>
            <Grid>
                <TextBlock Text="TOTAL" FontFamily="Georgia" FontSize="15" 
                           FontWeight="Bold" Foreground="#C9A84C"/>
                <TextBlock HorizontalAlignment="Right" FontFamily="Georgia" 
                           FontSize="15" FontWeight="Bold" Foreground="#C9A84C">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} RON">
                            <Binding Path="Total"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0 10 0 0">
            <Button Content="← Close"
                    Style="{StaticResource CartButtonStyle}"
                    HorizontalAlignment="Left"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Place Order →"
                    Style="{StaticResource CartButtonStyle}"
                    HorizontalAlignment="Right"
                    Command="{Binding PlaceOrderCommand}"/>
        </Grid>
    </Grid>
</UserControl>