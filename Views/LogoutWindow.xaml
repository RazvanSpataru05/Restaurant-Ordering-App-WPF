<Window x:Class="RestaurantOrderingApp.Views.LogoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Out"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#1C1C1C"
        WindowStyle="None"
        TextElement.Foreground="#E0E0E0"
        FontFamily="Georgia">

    <Border Background="#1C1C1C" BorderBrush="#C9A84C" 
            BorderThickness="1" CornerRadius="4">
        <StackPanel Margin="36,32,36,28">

            <TextBlock Text="LOG OUT"
                   FontSize="20" FontStyle="Italic"
                   Foreground="#C9A84C"
                   HorizontalAlignment="Center"/>
            <Rectangle Height="1" Fill="#2A2A2A" Margin="0,14,0,20"/>

            <TextBlock Text="{Binding InfoMessage}"
                   FontFamily="Georgia" FontSize="13"
                   Foreground="#E0E0E0"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,0,0,24"/>

            <Rectangle Height="1" Fill="#2A2A2A" Margin="0,0,0,20"/>

            <Grid>
                <Button Content="No"
                    Style="{StaticResource ToggleButtonStyle}"
                    Command="{Binding NoCommand}"
                    Width="110"
                    HorizontalAlignment="Left"/>
                <Button Content="Yes"
                    Style="{StaticResource ToggleButtonStyle}"
                    Command="{Binding YesCommand}"
                    Width="110"
                    HorizontalAlignment="Right"/>
            </Grid>

        </StackPanel>
    </Border>

</Window>